{
  "name": "tpen-line-history",
  "version": "1.0.0",
  "description": "A custom web component for displaying the history of transcription lines from TPEN projects",
  "main": "tpen-line-history.js",
  "type": "module",
  "scripts": {
    "demo": "echo 'Open demo.html in your browser to see the component in action'",
    "test": "npm run test:contract && npm run test:api && npm run test:e2e",
    "test:contract": "node --test test/contracts/*.test.js",
    "test:api": "node --test test/api/*.test.js",
    "test:e2e": "playwright test",
    "test:compat": "node test/scripts/run-integration-smoke.js",
    "test:ci": "npm run test && npm run test:compat",
    "test:install-browsers": "playwright install chromium",
    "coverage": "c8 --reporter=text --reporter=lcov node --test test/contracts/*.test.js test/api/*.test.js",
    "coverage:html": "c8 --reporter=html --reporter=text node --test test/contracts/*.test.js test/api/*.test.js",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.56.0",
    "express": "^4.21.2",
    "@playwright/test": "^1.53.0",
    "supertest": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CenterForDigitalHumanities/tpen-line-history.git"
  },
  "keywords": [
    "tpen",
    "transcription",
    "history",
    "web-component",
    "custom-element",
    "rerum"
  ],
  "author": "Research Computing Group",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CenterForDigitalHumanities/tpen-line-history/issues"
  },
  "homepage": "https://github.com/CenterForDigitalHumanities/tpen-line-history#readme"
}
